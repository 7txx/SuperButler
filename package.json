{
  "name": "superbutler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "超级管家 SuperButler：订阅提醒 + 网站监控 + 个人导航（Cloudflare Worker 单服务部署）",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build && node scripts/provision.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 execute superbutler --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute superbutler --remote --file=./schema.sql",
    "cf:init": "npm run db:local && npm run db:remote"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.1",
    "hono": "^4.6.15",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wrangler": "^3.99.0"
  }
}
